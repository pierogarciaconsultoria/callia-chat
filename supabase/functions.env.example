# Segredos das edge functions (nunca no frontend). Copie para o env do edge-runtime.
SUPABASE_URL=http://kong:8000
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# URL pública das functions (usada em links/descoberta MCP). Ex.: https://api.seudominio.com/functions/v1
FUNCTIONS_PUBLIC_URL=

# Segredo para chamadas entre functions (process-message, webhook-dispatcher). 40+ caracteres aleatórios.
INTERNAL_FUNCTION_SECRET=
# Chave mestra AES-GCM dos segredos de webhooks de saída. 32+ caracteres. Trocar invalida os segredos atuais.
CALLIA_ENCRYPTION_KEY=
# Pepper opcional do hash das API keys. Trocar invalida todas as chaves emitidas.
API_KEY_PEPPER=

# Evolution API v2 (instância própria do Callia)
EVOLUTION_BASE_URL=http://callia-evolution:8080
EVOLUTION_API_KEY=
# Base que a Evolution usa para chamar o whatsapp-webhook. Ex.: http://kong:8000/functions/v1
EVOLUTION_WEBHOOK_BASE_URL=

# IA (OpenAI ou compatível). Sem chave, o agente responde só com FAQ e faz handoff.
AI_COMPAT_API_KEY=
AI_COMPAT_BASE_URL=https://api.openai.com/v1
AI_DEFAULT_MODEL=gpt-4o-mini
STT_MODEL=whisper-1
VISION_MODEL=gpt-4o-mini
TTS_MODEL=gpt-4o-mini-tts
# Opcional: sem ele a busca usa só palavra-chave (tsvector).
EMBEDDING_MODEL=text-embedding-3-small

# Segredos dos agentes externos, referenciados em agent_configs.external_agent_secret_ref
# EXTERNAL_AGENT_LOJA_ALFA=
